{
  "name": "aegis-security-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AEGIS — live SIEM, vulnerability assessment, and incident response. Created by Vaibhav Thakur.",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
